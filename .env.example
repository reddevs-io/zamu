# Postgres connection used by the web app, the worker and migrations.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/project_management

# Server used by tests to create throwaway databases (one per test run).
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres

# Better Auth: secret of at least 32 characters (generate with `openssl rand -base64 32`)
# and the URL the auth endpoints are served from.
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars-or-more
BETTER_AUTH_URL=http://localhost:3000

# Public base URL of the web app, used in invitation links and the CLI hints.
PUBLIC_URL=http://localhost:3000

# HTTP port of the web app.
PORT=3000

# Single sign-on with one OpenID Connect provider (optional; see docs/self-hosting.md).
# SSO is on when issuer, client ID and client secret are all set. Register this callback URL with the provider:
#   {BETTER_AUTH_URL}/api/auth/oauth2/callback/oidc
# OIDC_ISSUER=https://auth.example.com/application/o/project-management/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# Button label "Continue with {name}". Default: SSO.
# OIDC_PROVIDER_NAME=Authentik
# Default: openid email profile.
# OIDC_SCOPES=openid email profile
# invite (default): existing accounts and invited people only. auto: anyone the provider signs in becomes a member.
# OIDC_SIGNUP=invite
# Comma-separated groups whose members are workspace admins; synced at every SSO sign-in (owners are kept).
# OIDC_ADMIN_GROUPS=
# Claim with the user's groups. Default: groups.
# OIDC_GROUPS_CLAIM=groups
# true: treat the provider's email as verified even when email_verified is false or missing (Authentik's default
# email mapping always sends false). Only when people cannot change their own email at the provider, or only
# trusted people are admitted. Default: false.
# OIDC_TRUST_EMAIL=false
# disabled: SSO only (needs the OIDC_* variables above). API keys keep working. Default: enabled.
# PASSWORD_LOGIN=enabled

# Behind a reverse proxy: comma-separated headers that carry the client IP, checked in order (rate limiting and
# session records). Only list headers your proxy sets or overwrites: clients can send any header that reaches the
# app directly. Default: x-forwarded-for. Behind Cloudflare: cf-connecting-ip,x-forwarded-for
# TRUSTED_IP_HEADERS=

# docker compose (self-hosting) only: Postgres credentials for the bundled db service.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=project_management

# Time zone used to decide when a cycle ends (its end date at midnight). IANA name.
APP_TIME_ZONE=UTC
